# ==========================================
# CodeChef Solver - LLM Configuration
# ==========================================
# Provide at least ONE of the following keys.
# The solver automatically detects which key is present.

# 1. OpenRouter (Recommended - fast & reliable)
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 2. Groq (Fast & Free Tier available)
# Sign up at: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Google Gemini (Free tier available)
# Sign up at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
